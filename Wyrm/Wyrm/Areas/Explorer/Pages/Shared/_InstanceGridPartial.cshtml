@model Wyrm.ViewModels.ExplorerGridViewModel

<div class="d-flex justify-content-between align-items-center explorer-pane-title">
    <h5 class="mb-0"><i class="fa-solid fa-cube me-1"></i> @Model.ObjectType.Name</h5>
    <a asp-area="Explorer" asp-page="/CreateInstance" asp-route-objectTypeId="@Model.ObjectType.Id" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-plus"></i> New Instance
    </a>
</div>

@if (!Model.Rows.Any())
{
    <p class="text-muted mb-0">No instances found. Create one to get started.</p>
}
else
{
    <table class="table table-hover explorer-instance-table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Who Created</th>
                <th>Who Updated</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr class="explorer-instance-row" data-instance-id="@row.Id">
                    <td>@row.DisplayName</td>
                    <td>@row.CreatedByUserName</td>
                    <td>@row.UpdatedByUserName</td>
                    <td class="text-end" onclick="event.stopPropagation();">
                        <a asp-area="Explorer" asp-page="/EditInstance" asp-route-id="@row.Id" class="mx-1">Edit</a>
                        |
                        <a asp-area="Explorer" asp-page="/DeleteInstance" asp-route-id="@row.Id" class="mx-1">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
