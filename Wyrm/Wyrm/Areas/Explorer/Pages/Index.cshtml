@page
@model Wyrm.Areas.Explorer.Pages.IndexModel

@{
    ViewData["Title"] = "Explorer";
}

@section Styles {
    <link rel="stylesheet" href="~/css/explorer.css" asp-append-version="true" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-area="" asp-page="/Index">
                <i class="fa-solid fa-home"></i> Home
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            <a asp-area="Explorer" asp-page="/Index">
                <i class="fa-solid fa-compass"></i> Explorer
            </a>
        </li>
    </ol>
</nav>

<div class="card shadow">
    <div class="card-body p-0">
        <div class="explorer-shell" id="explorerShell"
             data-grid-url="@Url.Page(null, "Grid")"
             data-detail-url="@Url.Page(null, "Detail")">
            <div class="explorer-sidebar" id="explorerSidebar">
                <div class="explorer-pane-header"><i class="fa-solid fa-compass me-1"></i> Repositories</div>
                <div class="explorer-tree" id="explorerTree">
                    @if (!Model.Repositories.Any())
                    {
                        <p class="text-muted p-3 mb-0">No repositories found. Create one in the Designer first.</p>
                    }
                    else
                    {
                        <ul class="explorer-tree-root list-unstyled mb-0">
                            @foreach (var repository in Model.Repositories)
                            {
                                <li>
                                    <div class="explorer-tree-node explorer-tree-repo-node explorer-tree-expanded" data-toggle-target="repo-@repository.Id">
                                        <i class="fa-solid fa-chevron-right explorer-tree-caret"></i>
                                        <i class="fa-solid fa-database me-1"></i> @repository.Name
                                    </div>
                                    <ul class="explorer-tree-children list-unstyled" id="repo-@repository.Id">
                                        @if (!repository.ObjectTypes.Any())
                                        {
                                            <li class="explorer-tree-empty text-muted">No object types</li>
                                        }
                                        else
                                        {
                                            @foreach (var objectType in repository.ObjectTypes.OrderBy(ot => ot.Name))
                                            {
                                                <li>
                                                    <div class="explorer-tree-node explorer-tree-objecttype-node" data-object-type-id="@objectType.Id">
                                                        <i class="fa-solid fa-cube me-1"></i> @objectType.Name
                                                    </div>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="explorer-splitter explorer-splitter-v" id="explorerSplitterV"></div>
            <div class="explorer-main" id="explorerMain">
                <div class="explorer-top" id="explorerTop">
                    <div id="explorerGridBody">
                        <p class="text-muted mb-0">Select an object type from the tree to view its instances.</p>
                    </div>
                </div>
                <div class="explorer-splitter explorer-splitter-h" id="explorerSplitterH"></div>
                <div class="explorer-bottom" id="explorerBottom">
                    <div id="explorerDetailBody">
                        <p class="text-muted mb-0">Select an instance from the grid to view its details.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/explorer.js" asp-append-version="true"></script>
}
