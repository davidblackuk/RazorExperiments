<div class="explorer-pane-header d-flex justify-content-between align-items-center">
    <span><i class="fa-solid fa-compass me-1"></i> Repositories</span>
    <div>
        <Button Color="ButtonColor.Light" Size="ButtonSize.Small" TooltipTitle="Add Repository" @onclick="() => OnAddRequested.InvokeAsync()">
            <i class="fa-solid fa-plus"></i>
        </Button>
        <Button Color="ButtonColor.Light" Size="ButtonSize.Small" TooltipTitle="Delete Repository" Disabled="@(!CanDelete)" @onclick="() => OnDeleteRequested.InvokeAsync()">
            <i class="fa-solid fa-trash"></i>
        </Button>
    </div>
</div>

@code {
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public EventCallback OnAddRequested { get; set; }
    [Parameter] public EventCallback OnDeleteRequested { get; set; }
}
