<div class="explorer-tree">
    @if (!Repositories.Any())
    {
        <p class="text-muted p-3 mb-0">No repositories found. Create one in the Designer first.</p>
    }
    else
    {
        <ul class="explorer-tree-root list-unstyled mb-0">
            @foreach (var repository in Repositories.OrderBy(r => r.Name))
            {
                <li>
                    <div class="explorer-tree-node explorer-tree-repo-node @(IsCollapsed(repository.Id) ? "" : "explorer-tree-expanded") @(SelectedRepositoryId == repository.Id ? "active" : "")"
                         @onclick="() => SelectRepository(repository)">
                        <i class="fa-solid fa-chevron-right explorer-tree-caret"></i>
                        <i class="fa-solid fa-database me-1"></i> @repository.Name
                    </div>
                    <ul class="explorer-tree-children list-unstyled @(IsCollapsed(repository.Id) ? "explorer-tree-collapsed" : "")">
                        @if (!repository.ObjectTypes.Any())
                        {
                            <li class="explorer-tree-empty text-muted">No object types</li>
                        }
                        else
                        {
                            @foreach (var objectType in repository.ObjectTypes.OrderBy(ot => ot.Name))
                            {
                                <li>
                                    <div class="explorer-tree-node explorer-tree-objecttype-node @(SelectedObjectTypeId == objectType.Id ? "active" : "")"
                                         @onclick="() => OnObjectTypeSelected.InvokeAsync(objectType)">
                                        <i class="fa-solid fa-cube me-1"></i> @objectType.PluralName
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </li>
            }
        </ul>
    }
</div>
