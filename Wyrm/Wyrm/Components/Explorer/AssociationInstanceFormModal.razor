<Modal @ref="_modal" Title="Add Association" Size="ModalSize.Large" UseStaticBackdrop="true">
    <BodyTemplate>
        @if (_errors.Count > 0)
        {
            <Alert Color="AlertColor.Danger">
                <ul class="mb-0">
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </Alert>
        }
        @if (!_options.Any())
        {
            <p class="text-muted mb-0">No association types are eligible for this object.</p>
        }
        else
        {
            <div class="form-group mb-3">
                <label class="control-label">Association</label>
                <select class="form-control" @bind="_selectedOptionIndex" @bind:after="OnOptionChanged">
                    @for (var i = 0; i < _options.Count; i++)
                    {
                        <option value="@i">@_options[i].Label</option>
                    }
                </select>
            </div>
            @if (_selectedOption != null)
            {
                <div class="form-group mb-3">
                    <label class="control-label">Object</label>
                    @if (!_selectedOption.Candidates.Any())
                    {
                        <p class="text-muted mb-0">No eligible objects exist to link to.</p>
                    }
                    else
                    {
                        <select class="form-control" @bind="_selectedCandidateId">
                            @foreach (var candidate in _selectedOption.Candidates)
                            {
                                <option value="@candidate.InstanceId">@candidate.ObjectTypeName: @candidate.DisplayName</option>
                            }
                        </select>
                    }
                </div>
                @foreach (var field in _propertyFields)
                {
                    <PropertyFieldEditor Field="field" />
                }
            }
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => _modal!.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="Save">Save</Button>
    </FooterTemplate>
</Modal>
