<div class="explorer-pane-header">
    <span><i class="fa-solid fa-clone me-1"></i> Instances</span>
</div>
<div id="explorerGridBody">
    @if (ObjectType == null)
    {
        <p class="text-muted mb-0">Select an object type from the tree to view its instances.</p>
    }
    else if (IsLoading)
    {
        <p class="text-muted mb-0">Loading&hellip;</p>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center explorer-pane-title">
            <h5 class="mb-0"><i class="fa-solid fa-cube me-1"></i> @ObjectType.Name</h5>
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => OnCreateRequested.InvokeAsync()">
                <i class="fa-solid fa-plus"></i> New Instance
            </Button>
        </div>

        @if (Rows == null || !Rows.Any())
        {
            <p class="text-muted mb-0">No instances found. Create one to get started.</p>
        }
        else
        {
            <Grid TItem="ExplorerInstanceRow" Class="table table-hover explorer-instance-table mb-0"
                  Data="Rows" AllowRowClick="true" OnRowClick="HandleRowClick" RowClass="GetRowClass">
                <GridColumns>
                    <GridColumn TItem="ExplorerInstanceRow" HeaderText="Name">@context.DisplayName</GridColumn>
                    <GridColumn TItem="ExplorerInstanceRow" HeaderText="Who Created">@context.CreatedByUserName</GridColumn>
                    <GridColumn TItem="ExplorerInstanceRow" HeaderText="Who Updated">@context.UpdatedByUserName</GridColumn>
                    <GridColumn TItem="ExplorerInstanceRow" HeaderText="Actions" HeaderTextAlignment="Alignment.End" TextAlignment="Alignment.End">
                        <span @onclick:stopPropagation="true">
                            <Button Color="ButtonColor.Link" Size="ButtonSize.Small" @onclick="() => OnEditRequested.InvokeAsync(context.Id)">Edit</Button>
                            <Button Color="ButtonColor.Link" Size="ButtonSize.Small" @onclick="() => OnDeleteRequested.InvokeAsync(context.Id)">Delete</Button>
                        </span>
                    </GridColumn>
                </GridColumns>
            </Grid>
        }
    }
</div>
