<Modal @ref="_modal" Title="@_title" Size="ModalSize.Large" UseStaticBackdrop="true">
    <BodyTemplate>
        @if (_errors.Count > 0)
        {
            <Alert Color="AlertColor.Danger">
                <ul class="mb-0">
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </Alert>
        }
        @foreach (var field in _fields)
        {
            <PropertyFieldEditor Field="field" />
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => _modal!.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="Save">Save</Button>
    </FooterTemplate>
</Modal>
