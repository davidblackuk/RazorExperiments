<div class="explorer-pane-header">
    <span><i class="fa-solid fa-clone me-1"></i> Details</span>
</div>
<div id="explorerDetailBody">
    @if (IsLoading)
    {
        <p class="text-muted mb-0">Loading&hellip;</p>
    }
    else if (Detail == null)
    {
        <p class="text-muted mb-0">Select an instance from the grid to view its details.</p>
    }
    else
    {
        var objectType = Detail.ObjectInstance.ObjectType!;
        <div class="d-flex justify-content-between align-items-center explorer-pane-title">
            <h5 class="mb-0"><i class="fa-solid fa-clone me-1"></i> @Detail.DisplayName</h5>
            <div>
                <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => OnEditRequested.InvokeAsync()">Edit</Button>
                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => OnDeleteRequested.InvokeAsync()">Delete</Button>
            </div>
        </div>
        <dl class="row mb-0 mt-2">
            @foreach (var propertyType in objectType.PropertyTypes)
            {
                var value = Detail.Values.GetValueOrDefault(propertyType.Id);
                <dt class="col-sm-3">@propertyType.Name</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrEmpty(value))
                    {
                        <span class="text-muted">(not set)</span>
                    }
                    else if (propertyType.DataType == PropertyDataType.Memo)
                    {
                        <span style="white-space: pre-wrap;">@value</span>
                    }
                    else
                    {
                        @value
                    }
                </dd>
            }
        </dl>
    }
</div>
