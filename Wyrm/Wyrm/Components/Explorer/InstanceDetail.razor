<div class="explorer-pane-header d-flex justify-content-between align-items-center">
    @if (Detail != null)
    {
        <span><i class="fa-solid fa-clone me-1"></i> @Detail.ObjectInstance.ObjectType!.Name: @Detail.DisplayName</span>
        <div>
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => OnEditRequested.InvokeAsync()">Edit</Button>
            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => OnDeleteRequested.InvokeAsync()">Delete</Button>
        </div>
    }
    else
    {
        <span><i class="fa-solid fa-clone me-1"></i> Details</span>
    }
</div>
<div class="explorer-pane-body" id="explorerDetailBody">
    @if (IsLoading)
    {
        <p class="text-muted mb-0">Loading&hellip;</p>
    }
    else if (Detail == null)
    {
        <p class="text-muted mb-0">Select an instance from the grid to view its details.</p>
    }
    else
    {
        var objectType = Detail.ObjectInstance.ObjectType!;
        <Tabs @key="Detail.ObjectInstance.Id">
            <Tab Title="Properties">
                <Content>
                    <dl class="row mb-0 mt-2">
                        @foreach (var propertyType in objectType.PropertyTypes)
                        {
                            var value = Detail.Values.GetValueOrDefault(propertyType.Id);
                            <dt class="col-sm-3">@propertyType.Name</dt>
                            <dd class="col-sm-9">
                                @if (string.IsNullOrEmpty(value))
                                {
                                    <span class="text-muted">(not set)</span>
                                }
                                else if (propertyType.DataType == PropertyDataType.Memo)
                                {
                                    <span style="white-space: pre-wrap;">@value</span>
                                }
                                else
                                {
                                    @value
                                }
                            </dd>
                        }
                    </dl>
                </Content>
            </Tab>
            <Tab Title="Associated Objects">
                <Content>
                    <div class="d-flex justify-content-end mb-2 mt-2">
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => OnAddAssociationRequested.InvokeAsync()">
                            <i class="fa-solid fa-plus me-1"></i>Add Association
                        </Button>
                    </div>
                    @if (AssociatedObjectsLoading)
                    {
                        <p class="text-muted mb-0">Loading&hellip;</p>
                    }
                    else if (AssociatedObjects == null || !AssociatedObjects.Any())
                    {
                        <p class="text-muted mb-0">No associated objects.</p>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Association</th>
                                    <th>Object</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in AssociatedObjects)
                                {
                                    <tr>
                                        <td><i class="fa-solid fa-link me-1"></i>@row.DirectionLabel</td>
                                        <td>@row.OtherObjectTypeName: @row.OtherDisplayName</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-light btn-sm" title="Delete" @onclick="() => OnDeleteAssociationRequested.InvokeAsync(row.AssociationInstanceId)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </Content>
            </Tab>
        </Tabs>
    }
</div>
