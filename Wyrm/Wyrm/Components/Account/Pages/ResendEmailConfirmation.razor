@page "/Account/ResendEmailConfirmation"
@attribute [AllowAnonymous]
@layout AuthLayout
@inject UserManager<IdentityUser> UserManager
@inject IEmailSender<IdentityUser> EmailSender
@inject NavigationManager NavigationManager

<PageTitle>Resend email confirmation - Wyrm</PageTitle>
<h2 class="glass-text mb-0 text-center pb-3">Resend email confirmation</h2>

<div class="row">
    <div class="col-md-4">
        <h4 class="glass-text pb-2">Please enter your email address</h4>
        <EditForm Model="Input" method="post" OnValidSubmit="ResendConfirmation" FormName="resend-email-confirmation">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="text-danger" role="alert">@message</div>
            }
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email" class="form-label"></label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Resend</button>
        </EditForm>
        <a href="Account/Login">Back to the logon page</a>
    </div>
</div>
