@page "/Account/ForgotPassword"
@layout AuthLayout
@inject UserManager<IdentityUser> UserManager
@inject IEmailSender<IdentityUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Forgot your password - Wyrm</PageTitle>
<h2 class="glass-text mb-0 text-center pb-3">Forgot your password</h2>

<div class="row">
    <div class="col-12">
        <h4 class="glass-text pb-2">Please enter your email</h4>
        <EditForm Model="Input" method="post" OnValidSubmit="RequestReset" FormName="forgot-password">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email" class="form-label"></label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
        </EditForm>
        <a href="Account/Login">Back to the logon page</a>
    </div>
</div>
