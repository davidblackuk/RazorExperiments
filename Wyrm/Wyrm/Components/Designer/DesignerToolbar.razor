<div class="explorer-pane-header d-flex justify-content-between align-items-center">
    <span><i class="fa-solid fa-list me-1"></i> Repositories</span>
    <div class="position-relative" @onclick:stopPropagation="true">
        <button type="button" class="btn btn-light btn-sm" title="Actions" @onclick="ToggleMenu">
            <i class="fa-solid fa-ellipsis-vertical"></i>
        </button>
        @if (_menuOpen)
        {
            <div class="dropdown-menu-overlay" @onclick="CloseMenu"></div>
            <ul class="dropdown-menu dropdown-menu-end show">
                <li>
                    <button type="button" class="dropdown-item" @onclick="() => { CloseMenu(); OnAddRequested.InvokeAsync(); }">
                        <i class="fa-solid fa-plus me-2"></i>Add Repository
                    </button>
                </li>
            </ul>
        }
    </div>
</div>
