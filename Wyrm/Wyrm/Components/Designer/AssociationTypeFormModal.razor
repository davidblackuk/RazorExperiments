<Modal @ref="_modal" Title="@_title" UseStaticBackdrop="true">
    <BodyTemplate>
        @if (_error != null)
        {
            <Alert Color="AlertColor.Danger">@_error</Alert>
        }
        <div class="form-group mb-3">
            <label class="control-label">Forward Name</label>
            <input class="form-control" @bind="_forwardName" @bind:event="oninput" />
        </div>
        <div class="form-group mb-3">
            <label class="control-label">Reverse Name</label>
            <input class="form-control" @bind="_reverseName" @bind:event="oninput" />
        </div>
        <div class="form-group mb-3">
            <label class="control-label">Description</label>
            <textarea class="form-control" rows="4" @bind="_description" @bind:event="oninput"></textarea>
        </div>
        <div class="form-group mb-3">
            <label class="control-label">Source Object Type</label>
            <select class="form-control" @bind="_sourceObjectTypeId">
                <option value="">Any</option>
                @foreach (var objectType in _objectTypes)
                {
                    <option value="@objectType.Id">@objectType.Name</option>
                }
            </select>
        </div>
        <div class="form-group mb-3">
            <label class="control-label">Target Object Type</label>
            <select class="form-control" @bind="_targetObjectTypeId">
                <option value="">Any</option>
                @foreach (var objectType in _objectTypes)
                {
                    <option value="@objectType.Id">@objectType.Name</option>
                }
            </select>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => _modal!.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="Save">Save</Button>
    </FooterTemplate>
</Modal>
