@page "/Designer"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IRepositoryService RepositoryService
@inject IObjectTypeService ObjectTypeService
@inject IPropertyTypeService PropertyTypeService
@inject IAssociationTypeService AssociationTypeService
@inject IAssociationPropertyTypeService AssociationPropertyTypeService
@inject IJSRuntime JS

<PageTitle>Designer</PageTitle>

<div class="card shadow explorer-page">
    <div class="card-body p-0 explorer-page-body">
        <div class="explorer-shell">
            <div class="explorer-sidebar">
                <DesignerToolbar OnAddRequested="OpenCreateRepositoryForm" />
                @if (_repositoryError != null)
                {
                    <Alert Color="AlertColor.Danger" Class="m-2 py-1 px-2 d-flex justify-content-between align-items-start">
                        <span>@_repositoryError</span>
                        <button type="button" class="btn-close" @onclick="() => _repositoryError = null"></button>
                    </Alert>
                }
                @if (_objectTypeError != null)
                {
                    <Alert Color="AlertColor.Danger" Class="m-2 py-1 px-2 d-flex justify-content-between align-items-start">
                        <span>@_objectTypeError</span>
                        <button type="button" class="btn-close" @onclick="() => _objectTypeError = null"></button>
                    </Alert>
                }
                <SchemaTree Repositories="_repositories"
                            SelectedRepositoryId="_selectedRepositoryId" OnRepositorySelected="SelectRepository"
                            OnAddObjectTypeRequested="OpenCreateObjectTypeForm" OnEditRepositoryRequested="OpenEditRepositoryForm" OnDeleteRepositoryRequested="DeleteRepositoryAsync"
                            SelectedObjectTypeId="_selectedObjectType?.Id" OnObjectTypeSelected="SelectObjectTypeAsync"
                            OnAddPropertyTypeRequested="OpenCreatePropertyTypeForm" OnEditObjectTypeRequested="OpenEditObjectTypeForm" OnDeleteObjectTypeRequested="DeleteObjectTypeAsync"
                            OnAddAssociationTypeRequested="OpenCreateAssociationTypeForm"
                            SelectedAssociationTypeId="_selectedAssociationType?.Id" OnAssociationTypeSelected="SelectAssociationTypeAsync"
                            OnAddAssociationPropertyTypeRequested="OpenCreateAssociationPropertyTypeForm" OnEditAssociationTypeRequested="OpenEditAssociationTypeForm" OnDeleteAssociationTypeRequested="DeleteAssociationTypeAsync" />
            </div>
            <div class="explorer-splitter explorer-splitter-v"></div>
            <div class="explorer-main">
                <div class="explorer-top">
                    @if (_selectedAssociationType != null)
                    {
                        <AssociationPropertyTypeGrid AssociationType="_selectedAssociationType" PropertyTypes="_associationPropertyTypes" IsLoading="_gridLoading"
                                                      SelectedPropertyTypeId="_selectedAssociationPropertyType?.Id"
                                                      OnPropertyTypeSelected="SelectAssociationPropertyTypeAsync"
                                                      OnEditRequested="OpenEditAssociationPropertyTypeForRowAsync"
                                                      OnDeleteRequested="DeleteAssociationPropertyTypeForRowAsync" />
                    }
                    else
                    {
                        <PropertyTypeGrid ObjectType="_selectedObjectType" PropertyTypes="_propertyTypes" IsLoading="_gridLoading"
                                          SelectedPropertyTypeId="_selectedPropertyType?.Id"
                                          OnPropertyTypeSelected="SelectPropertyTypeAsync"
                                          OnEditRequested="OpenEditPropertyTypeForRowAsync"
                                          OnDeleteRequested="DeletePropertyTypeForRowAsync" />
                    }
                </div>
                <div class="explorer-splitter explorer-splitter-h"></div>
                <div class="explorer-bottom">
                    @if (_selectedAssociationType != null)
                    {
                        <AssociationPropertyTypeDetail PropertyType="_selectedAssociationPropertyType" IsLoading="_detailLoading"
                                                        OnEditRequested="OpenEditFormForSelectedAssociationPropertyTypeAsync"
                                                        OnDeleteRequested="DeleteAssociationPropertyTypeForSelectedAsync" />
                    }
                    else
                    {
                        <PropertyTypeDetail PropertyType="_selectedPropertyType" IsLoading="_detailLoading"
                                             OnEditRequested="OpenEditFormForSelectedPropertyTypeAsync"
                                             OnDeleteRequested="DeletePropertyTypeForSelectedAsync" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<RepositoryFormModal @ref="_repositoryFormModal" OnSave="SaveRepositoryAsync" />
<ObjectTypeFormModal @ref="_objectTypeFormModal" OnSave="SaveObjectTypeAsync" />
<PropertyTypeFormModal @ref="_propertyTypeFormModal" OnSave="SavePropertyTypeAsync" />
<AssociationTypeFormModal @ref="_associationTypeFormModal" OnSave="SaveAssociationTypeAsync" />
<AssociationPropertyTypeFormModal @ref="_associationPropertyTypeFormModal" OnSave="SaveAssociationPropertyTypeAsync" />
<ConfirmDialog @ref="_confirmDialog" />
