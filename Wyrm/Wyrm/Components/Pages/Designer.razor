@page "/Designer"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IJSRuntime JS

<PageTitle>Designer</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/"><i class="fa-solid fa-home"></i> Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            <i class="fa-solid fa-list"></i> Designer
        </li>
    </ol>
</nav>

<div class="card shadow">
    <div class="card-body p-0">
        <div class="explorer-shell">
            <div class="explorer-sidebar">
                <DesignerToolbar OnAddRequested="OpenCreateRepositoryForm" />
                @if (_repositoryError != null)
                {
                    <Alert Color="AlertColor.Danger" Class="m-2 py-1 px-2 d-flex justify-content-between align-items-start">
                        <span>@_repositoryError</span>
                        <button type="button" class="btn-close" @onclick="() => _repositoryError = null"></button>
                    </Alert>
                }
                <SchemaTree Repositories="_repositories"
                            SelectedRepositoryId="_selectedRepositoryId" OnRepositorySelected="SelectRepository"
                            OnAddObjectTypeRequested="OpenCreateObjectTypeForm" OnEditRepositoryRequested="OpenEditRepositoryForm" OnDeleteRepositoryRequested="DeleteRepositoryAsync"
                            SelectedObjectTypeId="_selectedObjectType?.Id" OnObjectTypeSelected="SelectObjectTypeAsync"
                            OnAddPropertyTypeRequested="OpenCreatePropertyTypeForm" OnEditObjectTypeRequested="OpenEditObjectTypeForm" OnDeleteObjectTypeRequested="DeleteObjectTypeAsync" />
            </div>
            <div class="explorer-splitter explorer-splitter-v"></div>
            <div class="explorer-main">
                <div class="explorer-top">
                    <PropertyTypeGrid ObjectType="_selectedObjectType" PropertyTypes="_propertyTypes" IsLoading="_gridLoading"
                                      SelectedPropertyTypeId="_selectedPropertyType?.Id"
                                      OnPropertyTypeSelected="SelectPropertyTypeAsync"
                                      OnEditRequested="OpenEditPropertyTypeForRowAsync"
                                      OnDeleteRequested="DeletePropertyTypeForRowAsync" />
                </div>
                <div class="explorer-splitter explorer-splitter-h"></div>
                <div class="explorer-bottom">
                    <PropertyTypeDetail PropertyType="_selectedPropertyType" IsLoading="_detailLoading"
                                         OnEditRequested="OpenEditFormForSelectedPropertyTypeAsync"
                                         OnDeleteRequested="DeletePropertyTypeForSelectedAsync" />
                </div>
            </div>
        </div>
    </div>
</div>

<RepositoryFormModal @ref="_repositoryFormModal" OnSave="SaveRepositoryAsync" />
<ObjectTypeFormModal @ref="_objectTypeFormModal" OnSave="SaveObjectTypeAsync" />
<PropertyTypeFormModal @ref="_propertyTypeFormModal" OnSave="SavePropertyTypeAsync" />
<ConfirmDialog @ref="_confirmDialog" />
